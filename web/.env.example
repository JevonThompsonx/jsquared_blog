# Web app environment template.
# Copy to `web/.env.local` for local development.

# ── Database ──────────────────────────────────────────
# Use `file:/absolute/path/blog.db` for local SQLite, or libsql:// for Turso.
TURSO_DATABASE_URL=
# Only required for remote libsql:// or https:// URLs.
TURSO_AUTH_TOKEN=

# ── WorkOS AuthKit (required, keyless runtime) ─────────
# Public client ID from the WorkOS staging environment.
WORKOS_CLIENT_ID=
# Exact access-token issuer from the OIDC discovery document, not the AuthKit host.
WORKOS_ISSUER=
# Must match a callback registered in WorkOS. Supported values:
#   https://jsquaredadventures.com/callback
#   https://www.jsquaredadventures.com/callback
#   https://next.jsquaredadventures.com/callback
#   http://localhost:3000/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://jsquaredadventures.com/callback
# Generate with: openssl rand -base64 24
WORKOS_COOKIE_PASSWORD=
# 14 days. Host-scoped; do not set WORKOS_COOKIE_DOMAIN.
WORKOS_COOKIE_MAX_AGE=1209600
# Admin gate: verified WorkOS email + this allowlist + local users.role=admin + auth_time <= 24h.
ADMIN_ALLOWED_EMAILS=
# Verified staging dashboard (2026-11-25): Magic Auth (email one-time code),
# passkeys, Email + Password, and Google/Microsoft/GitHub/Apple OAuth are enabled.
# The dashboard Sign-up URL override must remain empty; setting it to
# /api/auth/signup makes AuthKit redirect back to the same endpoint in a loop.
# The app runtime remains keyless. Initiate login /api/auth/login is a dashboard
# value, not an app env var.
# WORKOS_API_KEY must NOT be set in the app environment. Operator-only scripts
# may receive it in their shell when registering redirects or capturing fixtures.

# ── Legacy auth (optional, one code-rollback cycle) ────
# Better Auth tables and these variables remain for rollback. The WorkOS runtime
# does not read or require them.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
AUTH_EMAIL_TRANSPORT=
AUTH_ALLOW_LOCAL_ORIGIN=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_ADMIN_GITHUB_IDS=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ── Cloudinary (legacy uploads only) ───────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Local media ───────────────────────────────────────
LOCAL_MEDIA_ROOT=

# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ── Maps (optional) ───────────────────────────────────
NEXT_PUBLIC_STADIA_MAPS_API_KEY=
ROUTING_PROVIDER=geoapify
GEOCODING_PROVIDER=geoapify
GEOAPIFY_API_KEY=

# ── Email / newsletter (optional) ──────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
COMMENT_NOTIFICATION_TO_EMAIL=
LISTMONK_URL=
LISTMONK_LIST_UUID=
LISTMONK_ACCESS_CLIENT_ID=
LISTMONK_ACCESS_CLIENT_SECRET=

# ── Rate limiting ─────────────────────────────────────
# Set RATE_LIMIT_DRIVER=memory on the single local Node origin.
RATE_LIMIT_DRIVER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cron / observability ───────────────────────────────
CRON_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_TELEMETRY_DISABLED=1

# ── Playwright / operator helpers ──────────────────────
E2E_BASE_URL=
E2E_WORKOS_STORAGE_STATE=
E2E_ADMIN_STORAGE_STATE=
E2E_ADMIN_POST_ID=
E2E_POST_SLUG=
E2E_ALLOW_REMOTE_ADMIN_MUTATIONS=
# Fixture capture only; never put these in the app service environment.
E2E_WORKOS_EMAIL=
# Optional fixture lifetime in seconds (default 3600, maximum 86400).
E2E_WORKOS_MAX_AGE=3600
# Operator-only: follow /signup into the live AuthKit hosted page without submitting.
E2E_AUTHKIT_HOSTED_SMOKE=
# Explicit target for workos:apply-env / workos:audit-identities.
WORKOS_ENV_FILE=
