{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "tsx ./scripts/build.ts",
    "build:node": "NEXT_OUTPUT=standalone next build",
    "build:analyze": "ANALYZE=true pnpm run build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx ./scripts/migrate.ts",
    "db:migrate:node": "node ./scripts/migrate-database.mjs",
    "db:verify": "node ./scripts/verify-schema.mjs",
    "db:reconcile": "node ./scripts/reconcile-migration-ledger.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:capture-workos-state": "node --import tsx/esm ./scripts/capture-workos-storage-state.ts",
    "workos:configure-redirects": "node ./scripts/configure-workos-redirects.mjs",
    "workos:apply-env": "node ./scripts/apply-workos-env.mjs",
    "workos:audit-identities": "node ./scripts/audit-workos-identity.mjs",
    "workos:provision-admins": "node ./scripts/provision-workos-admins.mjs",
    "test:authkit-smoke": "node ./scripts/smoke-authkit-anonymous.mjs",
    "seed:wishlist": "tsx ./scripts/seed-wishlist.ts",
    "backup:data": "node scripts/backup-blog-data.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "deploy:cf": "node scripts/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@sentry/nextjs": "10.78.0",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/extension-link": "3.35.0",
    "@tiptap/extension-placeholder": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@vinext/cloudflare": "^1.3.0",
    "@workos-inc/authkit-nextjs": "4.6.3",
    "@workos-inc/node": "12.4.0",
    "browser-image-compression": "2.0.2",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "emoji-picker-react": "^4.19.4",
    "maplibre-gl": "6.19.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "^8.1.2",
    "react-server-dom-webpack": "^19.3.1",
    "sanitize-html": "2.18.2",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "vinext": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@next/bundle-analyzer": "^16.3.4",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "1.0.0-beta.26",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "30.1.3",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "type": "module"
}
