{
  "name": "jsquaredadventures",
  "version": "0.5.0",
  "private": true,
  "description": "J² Adventures travel blog",
  "author": "Jevon Thompson",
  "license": "MIT",
  "homepage": "https://jsquaredadventures.com",
  "keywords": [
    "travel-blog",
    "nextjs"
  ],
  "scripts": {
    "dev": "pnpm --filter web run dev",
    "build": "pnpm --filter web run build",
    "lint": "pnpm --filter web run lint",
    "test": "pnpm --filter web run test",
    "dev:web": "pnpm --filter web run dev",
    "build:web": "pnpm --filter web run build",
    "lint:web": "pnpm --filter web run lint",
    "test:web": "pnpm --filter web run test",
    "prepare": "husky",
    "lint-staged": "pnpm --filter web exec lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@sentry/cli": "3.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "vercel": "^50.44.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.1.1"
}
