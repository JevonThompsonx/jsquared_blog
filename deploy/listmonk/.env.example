# Copy to .env on CT152 and chmod 600. Fill every value; never commit this file.
LISTMONK_app__address=0.0.0.0:9000
LISTMONK_app__root_url=https://listmonk.jsquaredadventures.com
LISTMONK_db__host=db
LISTMONK_db__port=5432
LISTMONK_db__user=listmonk
LISTMONK_db__password=CHANGE_ME
LISTMONK_db__database=listmonk
LISTMONK_db__ssl_mode=disable
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=CHANGE_ME
# SMTP is configured in the admin UI (Settings -> SMTP); these values are only
# defaults and are not authoritative.
LISTMONK_smtp__host=smtp.resend.com
LISTMONK_smtp__port=465
LISTMONK_smtp__auth_protocol=login
LISTMONK_smtp__username=resend
LISTMONK_smtp__password=CHANGE_ME
LISTMONK_smtp__from_email=newsletter@mail.jsquaredadventures.com
LISTMONK_smtp__tls_type=SSL
LISTMONK_smtp__helo_hostname=listmonk.jsquaredadventures.com
TZ=America/Los_Angeles
